# This file is intentionally NOT committed with real values.
# Copy to local.properties on your build machine:
#
#   sdk.dir=/Users/you/Library/Android/sdk        # macOS default
#   sdk.dir=/home/you/Android/Sdk                 # Linux default
#   sdk.dir=C\:\\Users\\you\\AppData\\Local\\Android\\Sdk   # Windows
#
# CI (GitHub Actions) installs the SDK automatically — no local.properties needed.
sdk.dir=/opt/android-sdk
